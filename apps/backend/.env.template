#REDIS_URL=redis://localhost:6379
JWT_SECRET=dfsdds
COOKIE_SECRET=dsfdsf
DATABASE_URL=postgres://admin:S3cret@localhost:5432/nimbus-medusa-dev
DB_NAME=nimbus-medusa-dev
# Individual DB_* vars are read by @medusajs/test-utils for the throwaway integration-test database.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=S3cret
# Client id and secret are shared by the Danish (DK) and Norwegian (NO) Business Central environments.
BUSINESS_CENTRAL_CLIENT_ID=
BUSINESS_CENTRAL_CLIENT_SECRET=
# Danish environment (DK): order API, order submission, shipment notices and Danish companies.
BUSINESS_CENTRAL_DISCOVERY_URL=https://api.businesscentral.dynamics.com/v2.0/f44eef10-122f-4a63-9f5c-bd9fbd87a364/TestDK/api/v2.0
# Business Central company ID (GUID); its name scopes the ODataV4 return calls.
BUSINESS_CENTRAL_COMPANY_ID=
# Local currency (LCY) used when a Business Central customer has a blank Currency Code.
BUSINESS_CENTRAL_LCY_CODE=DKK
# Norwegian environment (NO): companies whose country is NO. No default URL: without it, only NO
# calls fail. The values below are TestNO's.
BUSINESS_CENTRAL_NO_DISCOVERY_URL=https://api.businesscentral.dynamics.com/v2.0/f44eef10-122f-4a63-9f5c-bd9fbd87a364/TestNO/api/v2.0
BUSINESS_CENTRAL_NO_COMPANY_ID=223f0db0-7884-ee11-8178-002248dd26d9
BUSINESS_CENTRAL_NO_LCY_CODE=NOK
# Comma-separated Business Central environments integration tests may reach (default
# TestDK,TestNO). Tests abort if BUSINESS_CENTRAL_DISCOVERY_URL, or BUSINESS_CENTRAL_NO_DISCOVERY_URL
# when set, targets any other environment.
BUSINESS_CENTRAL_TEST_ENVIRONMENTS=TestDK,TestNO
# Storefront UI translations (NIMBUS-175). Storefront endpoint the backend calls after a committed
# translation change; HTTPS in hosted environments (loopback HTTP is allowed locally).
STOREFRONT_TRANSLATION_REVALIDATE_URL=
# Must match the storefront's REVALIDATE_SECRET. Generate a long random value per environment.
REVALIDATE_SECRET=
# Separate secret the storefront server uses to forward missing-text reports. Must match the storefront.
TRANSLATION_REPORT_SECRET=
